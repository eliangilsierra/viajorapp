-- Schema version 2 (migrations/1.sqm). Sync metadata on every synced table (ADR-0002).
CREATE TABLE activity (
    id TEXT NOT NULL PRIMARY KEY,
    trip_id TEXT NOT NULL REFERENCES trip(id),
    -- NULL means the activity is an unscheduled idea for the trip.
    day_id TEXT REFERENCES trip_day(id),
    place_id TEXT REFERENCES place(id),
    title TEXT NOT NULL CHECK (length(title) > 0),
    notes TEXT,
    kind TEXT NOT NULL DEFAULT 'activity' CHECK (kind IN ('activity', 'transport', 'lodging', 'meal', 'note')),
    -- Local date-time (YYYY-MM-DDTHH:MM) plus IANA zone id (ADR-0002); an end later than the start date is an overnight item.
    start_local TEXT,
    end_local TEXT,
    zone_id TEXT,
    -- Fractional-index key within the day (domain FractionalIndex).
    sort_key TEXT NOT NULL,
    completed_at INTEGER,
    source TEXT NOT NULL DEFAULT 'user' CHECK (source IN ('user', 'import', 'ai', 'geocoder')),
    deleted_at INTEGER,
    updated_at_hlc TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    CHECK (start_local IS NULL OR end_local IS NULL OR end_local >= start_local),
    CHECK (zone_id IS NOT NULL OR (start_local IS NULL AND end_local IS NULL))
);

CREATE INDEX activity_day ON activity(day_id, sort_key);
CREATE INDEX activity_trip ON activity(trip_id, deleted_at);

insertActivity:
INSERT INTO activity(id, trip_id, day_id, place_id, title, notes, kind, start_local, end_local, zone_id, sort_key, source, updated_at_hlc, updated_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectForDay:
SELECT * FROM activity WHERE day_id = ? AND deleted_at IS NULL ORDER BY sort_key, id;

selectUnscheduled:
SELECT * FROM activity WHERE trip_id = ? AND day_id IS NULL AND deleted_at IS NULL ORDER BY sort_key, id;

-- A reorder touches exactly one row (ADR-0002).
updateSortKey:
UPDATE activity SET sort_key = ?, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

setCompleted:
UPDATE activity SET completed_at = ?, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

softDeleteActivity:
UPDATE activity SET deleted_at = ?, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

restoreActivity:
UPDATE activity SET deleted_at = NULL, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

selectActivityById:
SELECT * FROM activity WHERE id = ?;

updateActivity:
UPDATE activity SET title = ?, notes = ?, kind = ?, start_local = ?, end_local = ?, zone_id = ?, place_id = ?, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

moveActivity:
UPDATE activity SET day_id = ?, sort_key = ?, updated_at_hlc = ?, updated_by = ? WHERE id = ?;

lastSortKeyForDay:
SELECT sort_key FROM activity WHERE day_id = ? AND deleted_at IS NULL ORDER BY sort_key DESC, id DESC LIMIT 1;

lastSortKeyUnscheduled:
SELECT sort_key FROM activity WHERE trip_id = ? AND day_id IS NULL AND deleted_at IS NULL ORDER BY sort_key DESC, id DESC LIMIT 1;
